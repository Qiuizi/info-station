{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "信息监控站",
  "version": "0.1.0",
  "identifier": "com.qi.infostation",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "信息监控站",
        "width": 1380,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["SimpChinese"], "installMode": "currentUser", "installerIcon": "icons/icon.ico" },
      "wix": { "language": "zh-CN" }
    }
  }
}
